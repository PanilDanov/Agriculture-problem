# Copy to .env for local execution. Never commit credentials.
ORBITFARM_API_HOST=127.0.0.1
ORBITFARM_API_PORT=8000
ORBITFARM_ML_HOST=127.0.0.1
ORBITFARM_ML_PORT=8001
ORBITFARM_ML_URL=http://127.0.0.1:8001
ORBITFARM_ML_TOKEN=
ORBITFARM_SOURCE_TIMEOUT=32
ORBITFARM_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Optional: an audited registry of crop-mask regional AgERA5 inputs.
# The bundled audited ES112 registry is used by default. Override for more regions.
# ORBITFARM_REGIONAL_INPUT_DIR=.runtime/regional-inputs
# ORBITFARM_PROVINCE_INPUT_DIR=agronomy/province_inputs
# Set automatically by the local launcher when serving the built website.
# ORBITFARM_FRONTEND_DIR=dist
# ORBITFARM_CACHE_DIR=.cache/field-sources
# Apple Silicon: set after running yield_prediction/install_native.py.
# ORBITFARM_NATIVE_LIB_DIR=.runtime/native

# For Vercel, ORBITFARM_ML_URL must be the reachable HTTPS inference service URL.
# A localhost address only works when the processes share the same computer.
