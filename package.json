{
  "name": "orbit-farm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "check:content": "node scripts/orbitFarm-verify-content.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run check:content && npm run typecheck && npm run test && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test:e2e": "playwright test",
    "verify": "npm run build && npm run test:e2e",
    "test:deploy": "node --test scripts/orbitFarm-deploy.test.mjs",
    "deploy:preview": "node scripts/orbitFarm-deploy.mjs",
    "deploy:production": "node scripts/orbitFarm-deploy.mjs --prod",
    "smoke:release": "node scripts/orbitFarm-smoke-release.mjs"
  },
  "dependencies": {
    "@fontsource/chakra-petch": "^5.2.5",
    "@fontsource/inter": "^5.2.5",
    "@turf/area": "^7.2.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/geojson": "^7946.0.16",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.8"
  }
}
